# StockNews Environment Variables
# Copy this file to .env and fill in your API keys.
# Keys prefixed with EXPO_PUBLIC_ are bundled with the app and visible to clients.
# Never commit real keys to source control.

# Finnhub API key – free tier at https://finnhub.io
# Without this key the app falls back to built-in mock data.
EXPO_PUBLIC_FINNHUB_API_KEY=
